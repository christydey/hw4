# Campus Customs — environment template
#
# Copy this file to `.env` in the repository root and fill in your own values.
# The real `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Only PORTKEY_API_KEY is required; everything else has a working default.

# ---- Required -------------------------------------------------------------

# Gateway credential used by the PydanticAI agent. Without it, POST /api/chat
# returns HTTP 503 naming this variable.
PORTKEY_API_KEY=your-portkey-api-key-here

# ---- AI model configuration ----------------------------------------------

# Model id the agent runs on. Reached through the Portkey gateway
# (https://api.portkey.ai/v1), which is set in backend/agent.py.
OPENAI_MODEL=gpt-5.6-luna

# ---- Optional backend configuration ---------------------------------------

# Path to the SQLite catalogue from the data pack.
# CAMPUS_CUSTOMS_DB=data/campus_customs.db

# Comma-separated frontend origins allowed by CORS.
# CAMPUS_CUSTOMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds before a single agent run is abandoned with HTTP 504.
# CAMPUS_CUSTOMS_CHAT_TIMEOUT=60

# Agent calls allowed per caller per rolling window before HTTP 429.
# CAMPUS_CUSTOMS_CHAT_RATE_LIMIT=12
# CAMPUS_CUSTOMS_CHAT_RATE_WINDOW=60

# Where the append-only audit trail is written.
# CAMPUS_CUSTOMS_AUDIT_LOG=output/audit_trail.json

# ---- Optional frontend configuration --------------------------------------

# API base URL used by the Vite frontend.
# VITE_API_URL=http://127.0.0.1:8000
